[Unit]
Description=lxcer scheduled backups
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=lxcer
StateDirectory=lxcer
StateDirectoryMode=0700
WorkingDirectory=/var/lib/lxcer
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"
ExecStart=/opt/lxcer/lxcer backup -config /etc/lxcer/config.yml -concurrently
UMask=0077
PrivateTmp=yes
TimeoutStartSec=4h
